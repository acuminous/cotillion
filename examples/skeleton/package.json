{
  "name": "cotillion-example-skeleton",
  "version": "0.0.0",
  "private": true,
  "description": "A skeleton service on cotillion: postgres, redis and a Hono HTTP server, started in order and stopped in reverse",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "docker:up": "docker compose up --detach --wait",
    "docker:down": "docker compose down --volumes",
    "start": "node --experimental-strip-types src/index.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.7",
    "cotillion": "file:../..",
    "hono": "^4.6.14",
    "ioredis": "^5.4.1",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "typescript": "^5.6.3"
  }
}
